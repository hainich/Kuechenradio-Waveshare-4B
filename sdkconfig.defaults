CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
# IDF otherwise defaults to 40 MHz even for Octal PSRAM. The framebuffer,
# bounce-buffer copies and PSRAM XIP share this bus; use the board's 80 MHz mode.
CONFIG_SPIRAM_SPEED_80M=y
# Bounce-buffer EOF copies and audio decoding need CPU headroom (IDF defaults to 160).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_FREERTOS_HZ=1000
# ESP-IDF default main-task stack is insufficient (observed stack overflow on hardware).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_BSP_DISPLAY_LVGL_BUF_HEIGHT=50
# Keep one RGB framebuffer: the double-buffer anti-tearing experiment worsened
# interference during MP3 playback on the physical Waveshare 4B.
CONFIG_BSP_LCD_RGB_BUFFER_NUMS=1
# Waveshare BSP's RGB panel allocates two SRAM bounce buffers of this height.
CONFIG_BSP_LCD_RGB_BOUNCE_BUFFER_HEIGHT=20
# Espressif recommends 64-byte cache lines for RGB PSRAM bounce-buffer copies.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# IDF 5.5.5 already restarts an incomplete bounce frame at VSYNC. Do not force
# a DMA reset every frame: the driver warns a late reset can itself shift a frame.
# CONFIG_LCD_RGB_RESTART_IN_VSYNC is not set
# CONFIG_BSP_DISPLAY_LVGL_AVOID_TEAR is not set
# CONFIG_BSP_DISPLAY_LVGL_DIRECT_MODE is not set
# Espressif's documented mitigations for RGB DMA starvation and screen drift.
# Relocate executable code and read-only data from flash into octal PSRAM.
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_CODEC_ES8311_SUPPORT=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# AtlasCube-proven TCP tuning for high-bitrate internet radio streams.
CONFIG_LWIP_TCP_WND_DEFAULT=32768
CONFIG_LWIP_TCP_RCV_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
